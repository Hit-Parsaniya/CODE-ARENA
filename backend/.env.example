# Database Configuration
# In Docker Compose: postgresql+psycopg2://postgres:postgres@postgres:5432/aicode_db
# Local standalone: postgresql+psycopg2://postgres:postgres@localhost:5432/aicode_db
DB_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/aicode_db

# Security & Authentication
JWT_SECRET=dev_jwt_secret_change_in_production_key_random_32_bytes
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Review Provider (Anthropic)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
